<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_kids">

    <!-- Header สำหรับเด็ก พร้อมช่องค้นหา -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@drawable/bg_header_kids"
        android:padding="@dimen/spacing_medium">

        <!-- บรรทัดแรก: ไอคอนและชื่อแอป -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/header_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_kids_tv"
                app:tint="@color/white"
                android:contentDescription="ไอคอนแอปสำหรับเด็ก" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_medium"
                android:text="วิดีโอสำหรับเด็ก"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- ปุ่มตัวเลือกการเรียงลำดับ -->
            <ImageView
                android:id="@+id/sort_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sort"
                app:tint="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:contentDescription="เรียงลำดับวิดีโอ" />

            <!-- ปุ่มรีเฟรช -->
            <ImageView
                android:id="@+id/refresh_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/spacing_small"
                android:src="@drawable/ic_refresh"
                app:tint="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:contentDescription="รีเฟรชรายการ" />

            <!-- ปุ่มสลับมุมมอง (List / Grid) -->
            <ImageView
                android:id="@+id/switch_view_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/spacing_small"
                android:src="@drawable/ic_view"
                app:tint="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:contentDescription="สลับมุมมอง" />

        </LinearLayout>

        <!-- บรรทัดที่สอง: ช่องค้นหา -->
        <LinearLayout
            android:id="@+id/search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:background="@drawable/bg_search_rounded_kids"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="@color/kids_accent"
                android:contentDescription="ไอคอนค้นหา" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="@null"
                android:hint="ค้นหาวิดีโอสำหรับเด็ก..."
                android:textColor="@color/kids_dark"
                android:textColorHint="@color/kids_dark_alpha_70"
                android:textSize="16sp"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/clear_search_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close_circle"
                app:tint="@color/kids_accent"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="ล้างการค้นหา" />

        </LinearLayout>

        <!-- แถบตัวเลือกหมวดหมู่ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none"
            android:fadeScrollbars="false">

            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/spacing_xsmall">

                <!-- หมวดหมู่ทั้งหมด -->
                <TextView
                    android:id="@+id/category_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_selected"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="ทั้งหมด"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:elevation="4dp"/>

                <!-- หมวดหมู่การ์ตูน -->
                <TextView
                    android:id="@+id/category_cartoon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:background="@drawable/bg_category_unselected"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="การ์ตูน"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:elevation="4dp"/>

                <!-- หมวดหมู่เพลง -->
                <TextView
                    android:id="@+id/category_music"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:background="@drawable/bg_category_unselected"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="เพลงเด็ก"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:elevation="4dp"/>

                <!-- หมวดหมู่เรียนรู้ -->
                <TextView
                    android:id="@+id/category_learning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:background="@drawable/bg_category_unselected"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="เรียนรู้"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:elevation="4dp"/>

                <!-- หมวดหมู่นิทาน -->
                <TextView
                    android:id="@+id/category_story"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:background="@drawable/bg_category_unselected"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="นิทาน"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:elevation="4dp"/>

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Banner Ad Container -->
    <FrameLayout
        android:id="@+id/banner_ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/kids_accent"
        android:visibility="visible">

        <!-- AdMob Banner Ad -->
<!--        <com.google.android.gms.ads.AdView-->
<!--            android:id="@+id/adView"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            ads:adSize="SMART_BANNER"-->
<!--            ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />-->

        <!-- Fallback Custom Banner สำหรับเด็ก -->
        <RelativeLayout
            android:id="@+id/custom_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_kids_banner"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ic_ad_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_kids_heart"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txt_ad_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="สนับสนุนนักพัฒนา"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_ad_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ขอบคุณที่ให้เด็กๆ ได้เรียนรู้"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_rounded_kids"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="สนับสนุน"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </FrameLayout>

    <!-- SwipeRefreshLayout -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_layout"
        android:layout_above="@id/banner_ad_container">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Shimmer Loading Effect สำหรับเด็ก -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:shimmer_auto_start="true"
                app:shimmer_duration="1200"
                app:shimmer_repeat_count="-1"
                app:shimmer_repeat_delay="0"
                app:shimmer_repeat_mode="restart">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <!-- Shimmer items สำหรับเด็ก -->
                    <include layout="@layout/include_shimmer_video_compact" />

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Main Content -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:overScrollMode="ifContentScrolls"
                android:padding="@dimen/spacing_medium"
                android:scrollbars="vertical"
                android:background="@drawable/bg_pattern_dots"
                tools:listitem="@layout/item_video_kids" />

            <!-- Empty State สำหรับเด็ก -->
            <include
                android:id="@+id/lyt_no_item_home"
                layout="@layout/include_no_item"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Error State สำหรับเด็ก -->
            <include
                android:id="@+id/lyt_failed_home"
                layout="@layout/include_failed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- No Search Results -->
            <LinearLayout
                android:id="@+id/lyt_no_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_large">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_search_empty"
                    app:tint="@color/kids_accent"
                    android:contentDescription="ไม่พบผลลัพธ์" />

                <TextView
                    android:id="@+id/txt_no_search_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="ไม่พบวิดีโอที่คุณค้นหา"
                    android:textColor="@color/kids_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_search_suggest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="ลองค้นหาด้วยคำอื่นดูสิ!"
                    android:textColor="@color/kids_dark_alpha_70"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_clear_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:background="@drawable/bg_button_kids"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="แสดงวิดีโอทั้งหมด"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </RelativeLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</RelativeLayout>