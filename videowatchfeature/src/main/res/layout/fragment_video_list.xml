<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F6">

    <!-- Scrollable Container for Top Header, Banner, Goals, Categories & Videos -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- 1. Hero Mascot Banner Section -->
                <RelativeLayout
                    android:id="@+id/hero_banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <!-- Spark Clips Banner Image -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_hero_banner"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/white">

                        <ImageView
                            android:id="@+id/img_hero_banner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/banner_spark_clips"
                            android:contentDescription="Spark Clips Banner" />
                    </androidx.cardview.widget.CardView>

                    <!-- Help '?' Button Top Right -->
                    <ImageButton
                        android:id="@+id/btn_help_spark"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_spark_help_btn"
                        android:src="@android:drawable/ic_menu_help"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:elevation="6dp"
                        app:tint="#FF5B6E"
                        android:contentDescription="ช่วยเหลือ" />

                    <!-- Greeting / Motivational Subtitle Under Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/card_hero_banner"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hi Haya! "
                            android:textColor="#FF4081"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap a clip and start your first spark."
                            android:textColor="#37474F"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Hidden / Compact Header Tools for Compatibility (Sort, Refresh, Fav, View Switch) -->
                <LinearLayout
                    android:id="@+id/header_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView android:id="@+id/header_icon" android:layout_width="1dp" android:layout_height="1dp" />
                    <TextView android:id="@+id/header_title" android:layout_width="1dp" android:layout_height="1dp" />
                    <ImageView android:id="@+id/sort_button" android:layout_width="1dp" android:layout_height="1dp" />
                    <ImageView android:id="@+id/refresh_button" android:layout_width="1dp" android:layout_height="1dp" />
                    <ImageView android:id="@+id/favorite_button" android:layout_width="1dp" android:layout_height="1dp" />
                    <ImageView android:id="@+id/switch_view_button" android:layout_width="1dp" android:layout_height="1dp" />
                </LinearLayout>

                <!-- 2. Today's Goal Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_todays_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Goal Header Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Today's goal"
                                android:textColor="#263238"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_goal_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 of 5 clips"
                                android:textColor="#FF5252"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Goal Progress Bar -->
                        <ProgressBar
                            android:id="@+id/progress_goal"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:max="100"
                            android:progress="20"
                            android:progressDrawable="@drawable/bg_spark_progress" />

                        <!-- 3 Stat Badges Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Streak Box -->
                            <LinearLayout
                                android:id="@+id/box_streak"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_spark_streak"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🔥"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/txt_streak_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#FF5722"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Streak"
                                    android:textColor="#78909C"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Stars Box -->
                            <LinearLayout
                                android:id="@+id/box_stars"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_spark_stars"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⭐"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/txt_stars_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#FFA000"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Stars"
                                    android:textColor="#78909C"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Clips Box -->
                            <LinearLayout
                                android:id="@+id/box_clips"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_spark_clips"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚡"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/txt_clips_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#7CB342"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Clips"
                                    android:textColor="#78909C"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Search Input Container (Collapsible or integrated) -->
                <LinearLayout
                    android:id="@+id/search_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_search_rounded_kids"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/search_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="#FF5B6E"
                        android:contentDescription="ค้นหา" />

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@null"
                        android:hint="ค้นหาวิดีโอสนุกๆ สำหรับเด็ก..."
                        android:textColor="@color/kids_dark"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />

                    <ImageView
                        android:id="@+id/clear_search_btn"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_close_circle"
                        app:tint="#FF5B6E"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="ล้างการค้นหา" />
                </LinearLayout>

                <!-- 3. Category Filter Chips Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/category_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- All Sparks (Selected) -->
                            <TextView
                                android:id="@+id/category_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_category_spark_all"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:text="🌈 All Sparks"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:elevation="2dp" />

                            <!-- Math Magic (Category 1) -->
                            <TextView
                                android:id="@+id/category_cartoon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_category_spark_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:text="🔢 Math Magic"
                                android:textColor="#37474F"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <!-- ABC (Category 2) -->
                            <TextView
                                android:id="@+id/category_music"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_category_spark_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:text="🔤 ABC"
                                android:textColor="#37474F"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <!-- Learning (Category 3) -->
                            <TextView
                                android:id="@+id/category_learning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_category_spark_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:text="🎨 เพลง &amp; ศิลปะ"
                                android:textColor="#37474F"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <!-- Story (Category 4) -->
                            <TextView
                                android:id="@+id/category_story"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_category_spark_unselected"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="9dp"
                                android:text="📖 นิทานเด็ก"
                                android:textColor="#37474F"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Filter Circle Button -->
                    <ImageButton
                        android:id="@+id/btn_filter_spark"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_spark_help_btn"
                        android:src="@drawable/ic_filter_spark"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="กรองวิดีโอ" />
                </LinearLayout>

                <!-- 4. Video List & States Section -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Shimmer Loading -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_view_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:shimmer_auto_start="true">
                        <include layout="@layout/include_shimmer_video_compact" />
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <!-- Main RecyclerView for Video Clips -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        tools:listitem="@layout/item_video_kids" />

                    <!-- Empty State -->
                    <include
                        android:id="@+id/lyt_no_item_home"
                        layout="@layout/include_no_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- Error State -->
                    <include
                        android:id="@+id/lyt_failed_home"
                        layout="@layout/include_failed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- No Search Results State -->
                    <LinearLayout
                        android:id="@+id/lyt_no_search_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_search_empty"
                            app:tint="#FF5B6E" />

                        <TextView
                            android:id="@+id/txt_no_search_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="ไม่พบวิดีโอที่คุณค้นหา"
                            android:textColor="#37474F"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_search_suggest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ลองค้นหาด้วยคำอื่นดูสิ!"
                            android:textColor="#78909C"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btn_clear_search"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_category_spark_all"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="10dp"
                            android:text="แสดงวิดีโอทั้งหมด"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                    <!-- Hidden Banner Ad Container for compatibility -->
                <FrameLayout
                    android:id="@+id/banner_ad_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <RelativeLayout
                        android:id="@+id/custom_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <ImageView android:id="@+id/ic_ad_icon" android:layout_width="1dp" android:layout_height="1dp"/>
                        <TextView android:id="@+id/txt_ad_title" android:layout_width="1dp" android:layout_height="1dp"/>
                        <TextView android:id="@+id/txt_ad_subtitle" android:layout_width="1dp" android:layout_height="1dp"/>
                        <TextView android:id="@+id/txt_ad_badge" android:layout_width="1dp" android:layout_height="1dp"/>
                    </RelativeLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</RelativeLayout>