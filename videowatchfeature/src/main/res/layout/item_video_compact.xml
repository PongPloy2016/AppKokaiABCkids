<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/lyt_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Left: Rounded Thumbnail with Play Button & Duration Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="122dp"
            android:layout_height="90dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A1A1A">

                <ImageView
                    android:id="@+id/video_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_thumbnail"
                    android:contentDescription="Video Thumbnail" />

                <FrameLayout
                    android:id="@+id/lyt_youtube_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Circular Play Button -->
                <ImageView
                    android:id="@+id/img_play"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_circle_white"
                    android:padding="8dp"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="#FF3D00"
                    android:contentDescription="Play" />

                <!-- Duration Badge (Bottom-Right) -->
                <TextView
                    android:id="@+id/video_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_duration_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="0:51"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right: Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Category Tag Pill (e.g. Spark Learning) -->
            <TextView
                android:id="@+id/category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_spark_learning"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Spark Learning"
                android:textColor="#FF4081"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Video Title -->
            <TextView
                android:id="@+id/video_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Driving In My Car 🚗"
                android:textColor="#2D3047"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Subtitle / Description -->
            <TextView
                android:id="@+id/video_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="learn words and movement"
                android:textColor="#78909C"
                android:textSize="11sp" />

            <!-- Bottom Row: Age Pill, Reward Pill & Overflow Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Age Badge Pill (e.g. 2-6 yrs) -->
                <TextView
                    android:id="@+id/txt_age_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_age_blue"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="2-6 yrs"
                    android:textColor="#0288D1"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <!-- Star Reward Pill (e.g. +5 ⭐) -->
                <TextView
                    android:id="@+id/txt_star_reward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_star_yellow"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="+5 ⭐"
                    android:textColor="#F57C00"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Three dots overflow icon -->
                <ImageButton
                    android:id="@+id/overflow"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="3dp"
                    android:src="@drawable/ic_dots_vertical"
                    app:tint="#9E9E9E"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>