<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:id="@+id/lyt_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- 1. Left Thumbnail Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="125dp"
            android:layout_height="105dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F4F8">

            <RelativeLayout
                android:id="@+id/lyt_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/video_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kids_placeholder"
                    android:contentDescription="ภาพตัวอย่างวิดีโอ" />

                <FrameLayout
                    android:id="@+id/lyt_youtube_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Play Button Overlay in Center -->
                <ImageView
                    android:id="@+id/img_play"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/ic_play_circle_kids"
                    app:tint="#FF5B6E"
                    android:padding="6dp"
                    android:elevation="4dp"
                    android:contentDescription="เล่นวิดีโอ" />

                <!-- Duration Badge at Bottom Right -->
                <TextView
                    android:id="@+id/video_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_rounded_kids"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="0:51"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Right Content Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical">

            <!-- Category Pill Badge -->
            <TextView
                android:id="@+id/category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pink"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Spark Learning"
                android:textColor="#FF4081"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Video Title -->
            <TextView
                android:id="@+id/video_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Driving In My Car 🚗"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Subtitle / Hashtag snippet -->
            <TextView
                android:id="@+id/video_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="#supersimplesongs #vehicles"
                android:textColor="#424242"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Description Snippet -->
            <TextView
                android:id="@+id/video_description_snippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spark Clip: learn vehicle words and movement."
                android:textColor="#757575"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Bottom Badges Row (Age, Rewards, Overflow Menu) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Age Badge -->
                <TextView
                    android:id="@+id/txt_age_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_cyan"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2.5dp"
                    android:text="2-6 yrs"
                    android:textColor="#0288D1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Rewards / Star Badge -->
                <TextView
                    android:id="@+id/txt_reward_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_orange"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2.5dp"
                    android:text="+5 ⭐"
                    android:textColor="#FF8F00"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Overflow 3-Dots Menu Button -->
                <ImageButton
                    android:id="@+id/overflow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_dots_vertical"
                    app:tint="#9E9E9E"
                    android:contentDescription="ตัวเลือกเพิ่มเติม" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>