<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF9A9E"
                android:endColor="#FAD0C4"
                android:angle="45" />
        </shape>
    </item>

    <!-- Floating shapes -->
    <item
        android:top="100dp"
        android:left="50dp"
        android:width="80dp"
        android:height="80dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" android:alpha="0.2" />
        </shape>
    </item>

    <item
        android:top="300dp"
        android:right="30dp"
        android:width="120dp"
        android:height="120dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" android:alpha="0.15" />
        </shape>
    </item>

    <item
        android:bottom="200dp"
        android:left="100dp"
        android:width="60dp"
        android:height="60dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" android:alpha="0.25" />
        </shape>
    </item>

</layer-list>