<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFD54F"
                android:endColor="#FFB300"
                android:type="radial"
                android:gradientRadius="40dp" />
            <stroke
                android:width="3dp"
                android:color="#FF8F00" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#4FC3F7"
                android:endColor="#29B6F6"
                android:type="radial"
                android:gradientRadius="40dp" />
            <stroke
                android:width="3dp"
                android:color="#0288D1" />
        </shape>
    </item>
</selector>
