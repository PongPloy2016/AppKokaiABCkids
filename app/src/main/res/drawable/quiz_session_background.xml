<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Primary soft warm gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFF5F7"
                android:centerColor="#F5F3FF"
                android:endColor="#EBF4FF"
                android:angle="135" />
        </shape>
    </item>

    <!-- Top-left pink pastel bubble -->
    <item
        android:top="-60dp"
        android:left="-60dp"
        android:width="220dp"
        android:height="220dp">
        <shape android:shape="oval">
            <solid android:color="#25FF80AB" />
        </shape>
    </item>

    <!-- Top-right sky blue bubble -->
    <item
        android:top="20dp"
        android:left="220dp"
        android:width="180dp"
        android:height="180dp">
        <shape android:shape="oval">
            <solid android:color="#2080D8FF" />
        </shape>
    </item>

    <!-- Mid-left mint bubble -->
    <item
        android:top="380dp"
        android:left="-50dp"
        android:width="170dp"
        android:height="170dp">
        <shape android:shape="oval">
            <solid android:color="#20A7F3D0" />
        </shape>
    </item>

    <!-- Bottom-right purple bubble -->
    <item
        android:top="580dp"
        android:left="180dp"
        android:width="200dp"
        android:height="200dp">
        <shape android:shape="oval">
            <solid android:color="#20E1BEE7" />
        </shape>
    </item>

</layer-list>
