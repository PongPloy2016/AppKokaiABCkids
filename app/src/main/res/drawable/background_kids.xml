<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="25dp" />

    <gradient
        android:angle="45"
        android:startColor="#FF6B9C"
        android:centerColor="#9CECFB"
        android:endColor="#74F2CE"
        android:type="linear" />

    <stroke
        android:width="3dp"
        android:color="#FFFFFF"
        android:dashWidth="8dp"
        android:dashGap="4dp" />

    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp" />

</shape>