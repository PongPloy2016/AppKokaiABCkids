<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCardSubHome"
    android:layout_width="match_parent"
    android:layout_height="200.0dip"  android:layout_margin="8dp"      android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16.0dip"    app:cardElevation="8.0dip"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:id="@+id/lloutCardSubHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"  android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgSubHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"        android:layout_weight="1"
            android:scaleType="fitCenter"
            android:padding="10.0dip"
            />

        <TextView
            android:id="@+id/txtCategoryTitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="ชื่อหมวดหมู่"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="#4CAF50"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>