<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCardSubHome"
    android:layout_width="match_parent"
    android:layout_height="195dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@color/card_default">

    <!-- Container -->
    <FrameLayout
        android:id="@+id/flCardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/lloutCardSubHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="false"
            android:focusable="false">

            <ImageView
                android:id="@+id/imgSubHome"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="Learning item" />

            <!-- Thai translation text badge -->
            <TextView
                android:id="@+id/tvThaiTranslation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_pill_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="คำแปล"
                android:textColor="#5E35B1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Highlight Overlay for reading effect -->
        <View
            android:id="@+id/readingGlowOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_reading_glow_border"
            android:visibility="gone" />

    </FrameLayout>

</androidx.cardview.widget.CardView>