<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootTracingLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_learning_scenery"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <!-- Back Button Pill -->
        <LinearLayout
            android:id="@+id/btnBackPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_back"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_left_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="ย้อนกลับ"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Star Counter on Top Right -->
        <LinearLayout
            android:id="@+id/starCounterLayout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_star_counter_pill"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Star"
                android:src="@drawable/star" />

            <TextView
                android:id="@+id/tvStarScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="120 ดาว"
                android:textColor="#F57F17"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Title and Star Progress Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvTracingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ฝึกเขียนตัวเลขแสนสนุก! 🔢"
            android:textColor="#0288D1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 3 Stars Progress Track -->
        <LinearLayout
            android:layout_width="240dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_progress_track_cute"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/starProgress1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Star 1"
                android:src="@drawable/ic_star_outline" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/starProgress2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Star 2"
                android:src="@drawable/ic_star_outline" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/starProgress3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Star 3"
                android:src="@drawable/ic_star_outline" />

        </LinearLayout>

    </LinearLayout>

    <!-- Main Tracing Canvas Card with Floating Prev/Next Buttons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="false">

            <com.pongploydev.kokaiabckids.drawingView.KidTracingCanvasView
                android:id="@+id/tracingCanvasView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

        <!-- Floating Previous Button on Left -->
        <FrameLayout
            android:id="@+id/btnFloatingPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_nav_btn_blue"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Previous"
                android:src="@drawable/ic_arrow_left_white" />

        </FrameLayout>

        <!-- Floating Next Button on Right -->
        <FrameLayout
            android:id="@+id/btnFloatingNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_nav_btn_blue"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Next"
                android:src="@drawable/ic_arrow_right_white" />

        </FrameLayout>

    </RelativeLayout>

    <!-- Drawing Tools Toolbar (Bottom Crayons & Actions) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <!-- Crayon Box Horizontal Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/crayonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Red Crayon (Selected Default) -->
                <ImageView
                    android:id="@+id/crayonRed"
                    android:layout_width="40dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Red Crayon"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:src="@drawable/ic_crayon"
                    app:tint="#FF5252" />

                <!-- Green Crayon -->
                <ImageView
                    android:id="@+id/crayonGreen"
                    android:layout_width="40dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Green Crayon"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:src="@drawable/ic_crayon"
                    app:tint="#4CAF50" />

                <!-- Yellow Crayon -->
                <ImageView
                    android:id="@+id/crayonYellow"
                    android:layout_width="40dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Yellow Crayon"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:src="@drawable/ic_crayon"
                    app:tint="#FFC107" />

                <!-- Blue Crayon -->
                <ImageView
                    android:id="@+id/crayonBlue"
                    android:layout_width="40dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Blue Crayon"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:src="@drawable/ic_crayon"
                    app:tint="#2196F3" />

                <!-- Orange Crayon -->
                <ImageView
                    android:id="@+id/crayonOrange"
                    android:layout_width="40dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Orange Crayon"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:src="@drawable/ic_crayon"
                    app:tint="#FF9800" />

                <!-- Purple Crayon -->
                <ImageView
                    android:id="@+id/crayonPurple"
                    android:layout_width="40dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Purple Crayon"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:src="@drawable/ic_crayon"
                    app:tint="#9C27B0" />

                <!-- Eraser -->
                <ImageView
                    android:id="@+id/toolEraser"
                    android:layout_width="40dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:contentDescription="Eraser"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:src="@drawable/ic_eraser_tool" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Bottom Action Controls: Prev, Reset, Mascot Indicator, Done, Next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Previous Button -->
            <FrameLayout
                android:id="@+id/btnPrevLetter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_nav_btn_blue"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Previous"
                    android:src="@drawable/ic_arrow_left_white" />

            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Reset / Clear Button -->
            <FrameLayout
                android:id="@+id/btnResetCanvas"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/sound_button_cartoon"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔄"
                    android:textSize="18sp" />

            </FrameLayout>

            <!-- Center Character Mascot & Indicator -->
            <LinearLayout
                android:id="@+id/centerMascotIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Mascot"
                    android:src="@drawable/pencil" />

                <TextView
                    android:id="@+id/tvCurrentLetterIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="1"
                    android:textColor="#37474F"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Done / Success Button -->
            <FrameLayout
                android:id="@+id/btnDoneTracing"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_pill_back"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✅"
                    android:textSize="18sp" />

            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Next Button -->
            <FrameLayout
                android:id="@+id/btnNextLetter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_nav_btn_blue"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Next"
                    android:src="@drawable/ic_arrow_right_white" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
