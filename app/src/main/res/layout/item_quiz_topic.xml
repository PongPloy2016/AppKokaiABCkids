<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTopic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp">

    <!-- Gradient background controlled via adapter -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Main gradient background (set via adapter) -->
        <LinearLayout
            android:id="@+id/layoutBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp"
            android:minHeight="100dp">

            <!-- Decorative blob bottom-right -->
            <View
                android:id="@+id/blobDecoRight"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:background="@drawable/quiz_header_bubble"
                android:alpha="0.18"
                android:layout_gravity="bottom|end" />

        </LinearLayout>

        <!-- Content overlay (on top of gradient) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp"
            android:minHeight="100dp">

            <!-- Badge number + Icon column -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Circular icon bg -->
                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/quiz_topic_icon_bg" />

                    <ImageView
                        android:id="@+id/ivTopicIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/card_one"
                        tools:src="@drawable/card_one" />
                </FrameLayout>

                <!-- Badge number top-left -->
                <TextView
                    android:id="@+id/tvBadgeNumber"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="-4dp"
                    android:layout_marginTop="-4dp"
                    android:background="@drawable/quiz_badge_bg"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Title + Description -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTopicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="หัวข้อแบบทดสอบ"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:shadowColor="#50000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/tvTopicDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="คำอธิบายสั้นๆ"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:alpha="0.88"
                    android:maxLines="2" />

                <!-- Chip-style tag -->
                <TextView
                    android:id="@+id/tvTopicTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/quiz_badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="เริ่มทำแบบทดสอบ ▶"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Arrow icon -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_forward"
                android:alpha="0.85"
                android:contentDescription="@null" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
