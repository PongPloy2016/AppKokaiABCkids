<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_view" >

    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="24dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxWidth="280dp"
        android:maxHeight="280dp"
        android:scaleType="fitCenter"
        android:src="@drawable/splash" />

    <ImageView
        android:id="@+id/decor_star1"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_above="@id/splash_logo"
        android:layout_alignLeft="@id/splash_logo"
        android:layout_marginBottom="16dp"
        android:layout_marginLeft="-24dp"
        android:src="@drawable/star" />

    <ImageView
        android:id="@+id/decor_star2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_below="@id/splash_logo"
        android:layout_alignRight="@id/splash_logo"
        android:layout_marginTop="16dp"
        android:layout_marginRight="-20dp"
        android:src="@drawable/star" />

    <ImageView
        android:id="@+id/decor_brush"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_toLeftOf="@id/splash_logo"
        android:layout_centerVertical="true"
        android:layout_marginRight="20dp"
        android:src="@drawable/brush" />

    <ImageView
        android:id="@+id/decor_palette"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_toRightOf="@id/splash_logo"
        android:layout_centerVertical="true"
        android:layout_marginLeft="20dp"
        android:src="@drawable/pallet" />

</RelativeLayout>