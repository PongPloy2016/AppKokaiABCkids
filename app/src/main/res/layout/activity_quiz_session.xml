<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quiz_session_background">

    <!-- Toolbar gradient -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/quiz_session_toolbar_bg"
        android:elevation="6dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="@color/white" />

    <!-- Top Header Info Row (Progress Pill & Score Badge Pill) -->
    <LinearLayout
        android:id="@+id/headerInfoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- Progress pill badge -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quiz_badge_bg"
            android:backgroundTint="#EDE7F6"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="ข้อ ๑ / ๒๐"
            android:textColor="#673AB7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Score emoji badge -->
        <TextView
            android:id="@+id/tvScoreBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quiz_badge_bg"
            android:backgroundTint="#FFF8E1"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="⭐ ๐ คะแนน"
            android:textColor="#FF8F00"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Rainbow progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:progressDrawable="@drawable/quiz_progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerInfoRow" />

    <!-- Question bubble with gradient -->
    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/quiz_question_bg"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:shadowColor="#30000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:text="❓ นี่คือตัวอะไร?"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <!-- Image card with colorful border -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvImage"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvQuestion"
        app:strokeColor="#F15BB5"
        app:strokeWidth="3dp">

        <ImageView
            android:id="@+id/ivQuestionImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/e_a" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Tap hint -->
    <TextView
        android:id="@+id/tvTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/quiz_badge_bg"
        android:backgroundTint="#EDE7F6"
        android:elevation="2dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="🔊 แตะที่รูปเพื่อฟังเสียงอ่าน 🎵"
        android:textColor="#5E35B1"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvImage" />

    <!-- 2x2 Options Grid -->
    <LinearLayout
        android:id="@+id/gridOptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTapHint">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Option 1 (A) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFF0F3"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#FF5252"
                app:strokeWidth="2.5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Option label badge -->
                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/quiz_badge_bg"
                        android:backgroundTint="#FF5252"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivOption1"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/e_a" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/tvOption1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="26sp"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:text="A"
                            android:textColor="#D32F2F"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivResult1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        tools:src="@drawable/ic_check_24" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 2 (B) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F0F7FF"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#29B6F6"
                app:strokeWidth="2.5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/quiz_badge_bg"
                        android:backgroundTint="#29B6F6"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivOption2"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/e_b" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/tvOption2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="26sp"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:text="B"
                            android:textColor="#0288D1"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivResult2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        tools:src="@drawable/ic_check_24" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Option 3 (C) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F0FFF4"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#66BB6A"
                app:strokeWidth="2.5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/quiz_badge_bg"
                        android:backgroundTint="#66BB6A"
                        android:gravity="center"
                        android:text="C"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivOption3"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/e_c" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/tvOption3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="26sp"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:text="C"
                            android:textColor="#388E3C"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivResult3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        tools:src="@drawable/ic_check_24" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 4 (D) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFF8E7"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#FFA726"
                app:strokeWidth="2.5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/quiz_badge_bg"
                        android:backgroundTint="#FFA726"
                        android:gravity="center"
                        android:text="D"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivOption4"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/e_d" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/tvOption4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="26sp"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:text="D"
                            android:textColor="#F57C00"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivResult4"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        tools:src="@drawable/ic_check_24" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Next button with gradient -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/quiz_btn_next_bg"
        android:text="ข้อถัดไป ▶"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="27dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
