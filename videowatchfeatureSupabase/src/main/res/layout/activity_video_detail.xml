<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient_kids">

    <!-- Header / Toolbar area -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FFF3E0"
                android:src="@drawable/ic_back_kids"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="กลับ"
                app:tint="#FF9800" />

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_kids_tv"
                    app:tint="@color/kids_pink" />
                <View
                    android:id="@+id/liveIndicatorDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/pulse_dot" />
            </FrameLayout>

            <TextView
                android:id="@+id/video_category_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="วิดีโอสำหรับเด็ก"
                android:textColor="@color/kids_text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"/>

            <!-- TTS Speaker Button -->
            <ImageButton
                android:id="@+id/btn_tts_voice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#F3E5F5"
                android:src="@drawable/ic_speaker_kids"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="อ่านออกเสียง"
                app:tint="#9C27B0" />

            <View
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/img_favorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FCE4EC"
                android:src="@drawable/ic_heart_outline"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="ถูกใจ"
                app:tint="@color/kids_pink" />

            <View
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#E0F2F1"
                android:src="@drawable/ic_share"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="แชร์"
                app:tint="@color/kids_secondary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Guideline at 48% of the screen -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_half"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.48" />

    <!-- Player Card (Top Section) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPlayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/cardHeader"
        app:layout_constraintBottom_toTopOf="@id/guideline_half"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/lyt_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ExoPlayer View -->
            <com.google.android.exoplayer2.ui.StyledPlayerView
                android:id="@+id/exoPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="true"
                app:show_timeout="3000"
                android:visibility="gone"/>

            <!-- WebView Fallback for Web/TeraBox Links -->
            <WebView
                android:id="@+id/player_web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>

            <!-- Local Video View -->
            <RelativeLayout
                android:id="@+id/lyt_local_video_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <VideoView
                    android:id="@+id/local_video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <ProgressBar
                    android:id="@+id/progress_bar_local"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:indeterminateTint="@color/kids_accent" />

                <LinearLayout
                    android:id="@+id/lyt_local_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageButton
                        android:id="@+id/btn_local_replay"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_button"
                        android:backgroundTint="#FF9800"
                        android:src="@drawable/ic_refresh"
                        app:tint="@android:color/white"
                        android:layout_marginEnd="16dp"/>

                    <ImageButton
                        android:id="@+id/btn_local_play_pause"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_button"
                        android:backgroundTint="#4CAF50"
                        android:src="@drawable/ic_exo_play"
                        app:tint="@android:color/white"
                        android:padding="12dp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_local_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#80000000"
                    android:src="@drawable/ic_back_kids"
                    app:tint="@android:color/white" />

            </RelativeLayout>

            <!-- Loading Overlay -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:indeterminateTint="#4CAF50"
                android:visibility="gone"/>

            <!-- Thumbnail Overlay -->
            <RelativeLayout
                android:id="@+id/lyt_thumbnail_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/video_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Play Button & Tap Banner in Center -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icon_play"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_play_button"
                        android:padding="10dp"
                        android:src="@drawable/ic_play_circle_kids" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_kids"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="แตะเพื่อเริ่มดูวิดีโอ 🚀"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Top Badge: Fun & Learning -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_age_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="✨ สื่อการเรียนรู้สำหรับเด็ก"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/video_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_rounded_kids"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Info/Details Card (Bottom Section) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardInfo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/guideline_half"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/lyt_main_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_view_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:shimmer_duration="1000"
                        android:visibility="gone">
                        <include layout="@layout/include_shimmer_content" />
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <!-- Title Row with Star Icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:id="@+id/icon_title_star"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_title_star"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/video_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Video Title"
                            android:textColor="@color/kids_text_dark"
                            android:textStyle="bold"
                            android:lineSpacingExtra="3dp"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- Info Chips Row (Views, Date, TTS Pill) -->
                    <LinearLayout
                        android:id="@+id/lyt_head"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <!-- View Count Chip -->
                        <LinearLayout
                            android:id="@+id/lyt_view_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_cyan"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_eye_kids"
                                app:tint="#00ACC1"/>
                            <TextView
                                android:id="@+id/total_views"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="0 views"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#00838F"/>
                        </LinearLayout>

                        <!-- Date Chip -->
                        <LinearLayout
                            android:id="@+id/lyt_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_orange"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_calendar_kids"
                                app:tint="#FB8C00"/>
                            <TextView
                                android:id="@+id/date_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Date"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#E65100"/>
                        </LinearLayout>

                        <!-- Quick Listen Voice Chip -->
                        <LinearLayout
                            android:id="@+id/chip_read_aloud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_pink"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_speaker_kids"
                                app:tint="#E91E63"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="ฟังเสียงอ่าน"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#C2185B"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Interactive Kids Reaction / Sticker Bar -->
                    <LinearLayout
                        android:id="@+id/lyt_kids_reactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_reaction_card"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ น้องๆ ให้คะแนนความสนุกวิดีโอนี้กันเถอะ! 🎉"
                            android:textColor="#5D4037"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <!-- Reaction: Love -->
                            <LinearLayout
                                android:id="@+id/btn_react_love"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_reaction_item"
                                    android:gravity="center"
                                    android:text="💖"
                                    android:textSize="20sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="รักเลย"
                                    android:textColor="#8D6E63"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <!-- Reaction: Clap -->
                            <LinearLayout
                                android:id="@+id/btn_react_clap"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_reaction_item"
                                    android:gravity="center"
                                    android:text="👏"
                                    android:textSize="20sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="เก่งมาก"
                                    android:textColor="#8D6E63"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <!-- Reaction: Fun -->
                            <LinearLayout
                                android:id="@+id/btn_react_fun"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_reaction_item"
                                    android:gravity="center"
                                    android:text="😆"
                                    android:textSize="20sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="สนุกจัง"
                                    android:textColor="#8D6E63"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <!-- Reaction: Star -->
                            <LinearLayout
                                android:id="@+id/btn_react_star"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_reaction_item"
                                    android:gravity="center"
                                    android:text="⭐"
                                    android:textSize="20sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="ยอดเยี่ยม"
                                    android:textColor="#8D6E63"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <!-- Reaction: Rocket -->
                            <LinearLayout
                                android:id="@+id/btn_react_rocket"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_reaction_item"
                                    android:gravity="center"
                                    android:text="🚀"
                                    android:textSize="20sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="ว้าวสุดๆ"
                                    android:textColor="#8D6E63"
                                    android:textSize="11sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Storybook Description Card -->
                    <LinearLayout
                        android:id="@+id/lyt_description_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_storybook_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_book_kids"
                                app:tint="#7209B7" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="สาระน่ารู้ &amp; เรื่องย่อ"
                                android:textColor="#4A148C"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <ImageView
                                android:id="@+id/btn_read_desc_voice"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_circle_button"
                                android:backgroundTint="#F3E5F5"
                                android:padding="5dp"
                                android:src="@drawable/ic_speaker_kids"
                                app:tint="#9C27B0"
                                android:contentDescription="อ่านเนื้อเรื่อง"/>
                        </LinearLayout>

                        <WebView
                            android:id="@+id/video_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent" />
                    </LinearLayout>

                    <!-- Suggested Videos Section -->
                    <RelativeLayout
                        android:id="@+id/lyt_suggested"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/lyt_suggested_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎈"
                                android:textSize="18sp"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:id="@+id/txt_suggested"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="วิดีโอสนุกๆ อื่นๆ ที่น้องๆ อาจชอบ"
                                android:textSize="16sp"
                                android:textColor="@color/kids_text_dark"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_suggested"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lyt_suggested_header"
                            android:nestedScrollingEnabled="false" />
                    </RelativeLayout>

                    <!-- Refresh Stream Button -->
                    <Button
                        android:id="@+id/btnRefreshStream"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 รีเฟรชสัญญาณวิดีโอ"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"/>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/lyt_failed_home"
        layout="@layout/include_failed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
