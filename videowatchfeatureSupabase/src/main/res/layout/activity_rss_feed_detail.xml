<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_kids">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <!-- Top Kids Navigation Bar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/kids_light_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/white"
                    android:contentDescription="กลับ"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back_kids"
                    app:tint="@color/kids_text_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_feed_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_pink"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="🌟 ฝึกอ่านและเขียน"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_source_provider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="แหล่งข้อมูล RSS / XML เด็ก"
                        android:textColor="@color/kids_text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/white"
                    android:contentDescription="ถูกใจ"
                    android:elevation="2dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/kids_pink" />

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/white"
                    android:contentDescription="แชร์"
                    android:elevation="2dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_share"
                    app:tint="@color/kids_secondary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="40dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/lyt_scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <!-- 1. Player / Hero Media Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_player"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- YouTube Player View -->
                    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                        android:id="@+id/youtube_player_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:enableAutomaticInitialization="false" />

                    <!-- Fallback Thumbnail with Play overlay -->
                    <RelativeLayout
                        android:id="@+id/lyt_thumbnail_fallback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/img_feed_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_thumbnail" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#44000000" />

                        <ImageView
                            android:id="@+id/img_play_overlay"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_play_circle_kids" />

                        <TextView
                            android:id="@+id/txt_media_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_duration_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="🎬 สื่อวิดีโอเด็ก"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Floating Top-Right PiP & FullScreen Controls on Video -->
                    <LinearLayout
                        android:id="@+id/lyt_player_controls_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:elevation="8dp">

                        <ImageButton
                            android:id="@+id/btn_pip_overlay"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_circle_button"
                            android:backgroundTint="#99000000"
                            android:contentDescription="ย่อจอเล็ก PiP"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_pip_kids"
                            app:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/btn_fullscreen_overlay"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_button"
                            android:backgroundTint="#99000000"
                            android:contentDescription="ขยายเต็มจอ"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_fullscreen_kids"
                            app:tint="@color/white" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 1.5 Quick Video Mode Buttons (PiP & Full Screen) -->
            <LinearLayout
                android:id="@+id/lyt_video_mode_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_pip_mode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_kids"
                    android:backgroundTint="#26A69A"
                    android:text="🗔 ย่อจอเล็ก (PiP)"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_fullscreen_mode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_kids"
                    android:backgroundTint="#FF6B8E"
                    android:text="⛶ ขยายเต็มจอ"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Title & Meta Information Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_title_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txt_feed_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="ชื่อหัวข้อนิทานและรายการเด็ก"
                        android:textColor="#263238"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_age_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_cyan"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="3-7 yrs"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_views_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_star_yellow"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="+5 ⭐ ยอดนิยม"
                            android:textColor="#E65100"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_feed_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="อัปเดตวันนี้"
                            android:textColor="#78909C"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Text-to-Speech (TTS) Audio Player Section for Kids -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_tts_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#F3E5F5"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icon_tts_speaker"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_speaker_kids"
                            app:tint="#8E24AA" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔊 อ่านนิทานให้ฟัง (Audio TTS)"
                                android:textColor="#4A148C"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_tts_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="กดปุ่มเริ่ม เพื่อให้น้องๆ ฟังเสียงอ่านสะกดคำแสนสนุก"
                                android:textColor="#7B1FA2"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_tts_start"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_kids"
                            android:backgroundTint="#8E24AA"
                            android:text="🔊 เริ่มอ่านให้ฟัง"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_tts_stop"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_button_kids"
                            android:backgroundTint="#B0BEC5"
                            android:paddingHorizontal="16dp"
                            android:text="⏹️ หยุด"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Story & Content Reading Box for Kids -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_story_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_book_kids"
                            app:tint="@color/kids_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="📖 นิทานและเนื้อหาสำหรับฝึกอ่าน"
                            android:textColor="@color/kids_text_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_marginVertical="12dp"
                        android:background="#ECEFF1" />

                    <!-- Large reading text for kids -->
                    <TextView
                        android:id="@+id/txt_feed_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="6dp"
                        android:text="เนื้อเรื่องย่อ นิทาน และบทเรียนสนุกๆ สำหรับเด็ก เพื่อฝึกสะกดคำ อ่านออกเสียงภาษาไทยอย่างถูกต้อง"
                        android:textColor="#37474F"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. Open Web Source Button -->
            <Button
                android:id="@+id/btn_open_web_source"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_button_kids"
                android:backgroundTint="@color/kids_secondary"
                android:text="🌐 เปิดดูบนเว็บไซต์ต้นฉบับ"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fullscreen Container for YouTube IFrame Native Fullscreen Callback -->
    <FrameLayout
        android:id="@+id/fl_fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="20dp"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
